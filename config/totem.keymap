#include "keys_en_gb.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Func        3

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                  &kp Q       &kp W       &kp E        &kp R        &kp T        &kp Y          &kp U          &kp I        &kp O       &kp P
                  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F  &kp G        &kp H          &hm RSHFT J    &hm LCTRL K  &hm RALT L  &hm RGUI SEMICOLON
&mt CAPSLOCK ESC  &kp Z       &kp X       &kp C        &kp V        &kp B        &kp N          &kp M          &kp COMMA    &kp DOT     &kp SLASH           &kp APOSTROPHE
                                          &kp DELETE   &lt Nav TAB  &kp SPACE    &kp BACKSPACE  &lt Sym ENTER  &kp MINUS
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
              &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6    &kp NUMBER_7     &kp NUMBER_8      &kp NUMBER_9       &kp NUMBER_0
              &kp LEFT_SHIFT  &kp CUT       &kp COPY      &kp PASTE     &kp UNDO        &kp LEFT_ARROW  &kp DOWN_ARROW   &kp UP_ARROW      &kp RIGHT_ARROW    &kp PIPE
&kp LEFT_ALT  &kp LEFT_GUI    &kp GRAVE     &kp TILDE     &kp BSPC      &kp DEL         &kp LEFT_PAREN  &kp RIGHT_PAREN  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DOT       &kp BACKSLASH
                                            &trans        &trans        &trans          &trans          &trans           &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
           &kp EXCL   &kp AT     &kp POUND_SIGN  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp SQT     &kp DQT
           &kp UNDER  &kp EQUAL  &kp LT          &kp GT      &kp PLUS       &kp MINUS  &kp SLASH      &kp BACKSLASH  &kp LBRC    &kp RBRC
&kp TILDE  &kp HASH   &kp PIPE   &kp GRAVE       &kp COLON   &kp SEMI       &kp LPAR   &kp RPAR       &kp LCURLY     &kp RCURLY  &kp BSLH  &kp END
                                 &trans          &trans      &trans         &trans     &trans         &trans
            >;
        };

        Func {
            display-name = "Func";
            bindings = <
        &kp F1      &kp F2      &kp F3    &kp F4    &kp F5      &kp F6    &kp F7      &kp F8    &kp F9  &kp F10
        &kp VOL_DN  &kp VOL_UP  &kp MUTE  &kp PLAY  &kp NEXT    &kp PREV  &kp BRDOWN  &kp BRUP  &trans  &trans
&trans  &trans      &trans      &trans    &trans    &trans      &trans    &trans      &trans    &trans  &trans   &trans
                                &trans    &trans    &trans      &trans    &trans      &trans
            >;
        };
    };
};
