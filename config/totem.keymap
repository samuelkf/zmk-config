/*
 * Custom Totem Split Layout - UK QWERTY + Vim + Symbols
 * Suitable for coding, sysadmin work, and general use.
 * Designed for ZMK firmware using keymap.keymap format.
 */

#include "keys_en_gb.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Func        3

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
            &kp Q       &kp W       &kp E        &kp R        &kp T        &kp Y          &kp U          &kp I        &kp O       &kp P
            &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F  &kp G        &kp H          &hm RSHFT J    &hm LCTRL K  &hm RALT L  &hm RGUI SEMICOLON
&kp ESCAPE  &kp Z       &kp X       &kp C        &kp V        &kp B        &kp N          &kp M          &kp COMMA    &kp DOT     &kp SLASH           &mt CAPSLOCK APOSTROPHE
                                    &kp DELETE   &lt Nav TAB  &kp SPACE    &kp BACKSPACE  &lt Sym ENTER  &kp MINUS
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
              &kp N1          &kp N2     &kp N3      &kp N4       &kp N5        &kp N6    &kp N7    &kp N8   &kp N9     &kp N0
              &kp LEFT_SHIFT  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &kp K_UNDO    &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT  &kp PIPE
&kp LEFT_ALT  &kp LEFT_GUI    &kp GRAVE  &kp TILDE   &kp BSPC     &kp DEL       &kp LBKT  &kp RBKT  &kp DOT  &kp BSLH   &trans    &trans
                                         &trans      &trans       &trans        &trans    &trans    &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
          &kp EXCL   &kp AT     &kp GB_POUND_SIGN  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR
          &kp EQUAL  &kp MINUS  &kp PLUS           &kp UNDER   &kp FSLH       &kp BSLH   &kp PIPE   &kp COLON  &kp SEMI   &kp SQT
&kp LBKT  &kp RBKT   &kp LBRC   &kp RBRC           &kp LT      &kp GT         &kp DOT    &kp COMMA  &kp GRAVE  &kp TILDE  &kp HASH  &trans
                                &trans             &mo 3       &trans         &trans     &trans     &trans
            >;
        };

        Func {
            display-name = "Func";
            bindings = <
        &kp F1        &kp F2        &kp F3      &kp F4            &kp F5        &kp F6      &kp F7        &kp F8         &kp F9  &kp F10
        &kp C_VOL_DN  &kp C_VOL_UP  &kp K_MUTE  &kp K_PLAY_PAUSE  &kp K_NEXT    &kp K_PREV  &kp C_BRI_DN  &kp C_BRI_INC  &trans  &trans
&trans  &trans        &trans        &trans      &trans            &trans        &trans      &trans        &trans         &trans  &trans   &trans
                                    &trans      &trans            &trans        &trans      &trans        &trans
            >;
        };
    };
};
